{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agentic Super App",
  "version": "0.1.0",
  "identifier": "com.agenticsuperapp.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../agentic-super-app-renderer dev",
    "beforeBuildCommand": "pnpm --dir ../../agentic-super-app-renderer build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../agentic-super-app-renderer/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agentic Super App",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
