{
  "name": "hiveory",
  "productName": "Hiveory",
  "version": "0.22.0",
  "private": true,
  "description": "Local-first AI Development Environment",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release": "node scripts/release.mjs",
    "e2e": "node scripts/e2e.mjs",
    "mobile": "pnpm --dir mobile",
    "mobile:install": "pnpm --dir mobile install",
    "mobile:check": "pnpm --dir mobile check"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.51.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xterm/headless": "^6.0.0",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "sherpa-onnx-node": "1.13.8",
    "uiohook-napi": "1.5.5",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "author": "Raktim Yoddha",
  "homepage": "https://github.com/raktim-yoddha/hiveory",
  "repository": {
    "type": "git",
    "url": "https://github.com/raktim-yoddha/hiveory.git"
  },
  "packageManager": "pnpm@11.5.3",
  "optionalDependencies": {
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.15",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.15"
  }
}
